# Copia este archivo como .env.local y completa los valores.
# Sin SMTP configurado, en desarrollo los correos se muestran en la consola.

NEXT_PUBLIC_SITE_URL=https://parabrisasdiaz.cl

# Servidor SMTP (Gmail: smtp.gmail.com, puerto 465, con "contraseña de aplicación")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=correo-que-envia@gmail.com
SMTP_PASS=contraseña-de-aplicacion

# Remitente visible y correo del vendedor que recibe las cotizaciones
MAIL_FROM="Parabrisas Díaz <correo-que-envia@gmail.com>"
MAIL_TO=vendedor@correo.cl
